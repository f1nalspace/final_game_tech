# =============================================================================
# FPL Presentation - Final Text Data (FTD) format
#
# All resources (fonts, sounds, images) are declared at the very top of this
# file inside the `Fonts`, `Sounds`, and `Images` namespaces.
#
# A `Resource` may be of one of two kinds:
#   - File   : loaded from disk via a relative file path (the demo's data dir)
#   - Memory : pass-through reference to a host-registered Resource defined in
#              builtin.h (the `BuiltinFonts` and `BuiltinImages` namespaces)
#
# Constants, background styles and text styles are likewise grouped into
# namespaces (`Const`, `Backgrounds`, `TextStyles`) so the slides reference
# everything through clean dotted paths.
# =============================================================================

# -----------------------------------------------------------------------------
# Type aliases
# -----------------------------------------------------------------------------
alias V2f = Vec2f
alias V3f = Vec3f
alias V4f = Vec4f

# -----------------------------------------------------------------------------
# Enum value aliases
# -----------------------------------------------------------------------------
alias Left   = HorizontalAlignment.Left
alias Center = HorizontalAlignment.Center
alias Right  = HorizontalAlignment.Right
alias Top    = VerticalAlignment.Top
alias Middle = VerticalAlignment.Middle
alias Bottom = VerticalAlignment.Bottom

# -----------------------------------------------------------------------------
# Fonts - memory resources are pass-throughs to BuiltinFonts (builtin.h)
# -----------------------------------------------------------------------------
Fonts {
    Debug             = BuiltinFonts.Debug
    Arimo             = BuiltinFonts.Arimo
    SulphurPoint      = BuiltinFonts.SulphurPoint
    BitStreamVerySans = BuiltinFonts.BitStreamVerySans
}

# -----------------------------------------------------------------------------
# Sounds - all file based, located in the demo's data/sounds folder
# -----------------------------------------------------------------------------
Sounds {
    Intro1     = Resource { name = "fpl_intro1.mp3"     type = File  file { filePath = "fpl_intro1.mp3" } }
    Intro2     = Resource { name = "fpl_intro2.mp3"     type = File  file { filePath = "fpl_intro2.mp3" } }
    WhoAmi1    = Resource { name = "fpl_whoami1.mp3"    type = File  file { filePath = "fpl_whoami1.mp3" } }
    What1      = Resource { name = "fpl_what1.mp3"      type = File  file { filePath = "fpl_what1.mp3" } }
    What2      = Resource { name = "fpl_what2.mp3"      type = File  file { filePath = "fpl_what2.mp3" } }
    Motivation = Resource { name = "fpl_motivation.mp3" type = File  file { filePath = "fpl_motivation.mp3" } }
}

# -----------------------------------------------------------------------------
# Images - memory resources pass through BuiltinImages, the rest are files
# -----------------------------------------------------------------------------
Images {
    # Memory pass-throughs
    FPLLogo128x128 = BuiltinImages.FPLLogo128x128
    FPLLogo512x512 = BuiltinImages.FPLLogo512x512

    # Feature cards
    Card_CPU              = Resource { name = "card_cpu.png"               type = File  file { filePath = "card_cpu.png" } }
    Card_Memory           = Resource { name = "card_memory.png"            type = File  file { filePath = "card_memory.png" } }
    Card_C_Language       = Resource { name = "card_c_language.png"        type = File  file { filePath = "card_c_language.png" } }
    Card_Audio            = Resource { name = "card_audio.png"             type = File  file { filePath = "card_audio.png" } }
    Card_Video            = Resource { name = "card_video.png"             type = File  file { filePath = "card_video.png" } }
    Card_WindowManagement = Resource { name = "card_window_management.png" type = File  file { filePath = "card_window_management.png" } }
    Card_Performance      = Resource { name = "card_performance.png"       type = File  file { filePath = "card_performance.png" } }
    Card_NoDependencies   = Resource { name = "card_no_deps.png"           type = File  file { filePath = "card_no_deps.png" } }
    Card_KeyboardMouse    = Resource { name = "card_keyboard_mouse.png"    type = File  file { filePath = "card_keyboard_mouse.png" } }
    Card_Gamepad          = Resource { name = "card_gamepad.png"           type = File  file { filePath = "card_gamepad.png" } }

    # Misc art
    MagicHat      = Resource { name = "magic_hat.png"      type = File  file { filePath = "magic_hat.png" } }
    Arigatou      = Resource { name = "arigatou.png"       type = File  file { filePath = "arigatou.png" } }
    MinimumSource = Resource { name = "minimum_source.png" type = File  file { filePath = "minimum_source.png" } }

    # Topic art
    DataVisualization = Resource { name = "data-visualization.png" type = File  file { filePath = "data-visualization.png" } }
    GameDev           = Resource { name = "game_dev.png"           type = File  file { filePath = "game_dev.png" } }
    MultimediaDev     = Resource { name = "multimedia_dev.png"     type = File  file { filePath = "multimedia_dev.png" } }
    FluidSandbox      = Resource { name = "sim_dev.png"            type = File  file { filePath = "sim_dev.png" } }
    Code              = Resource { name = "code.png"               type = File  file { filePath = "code.png" } }

    # Vendor logos
    Vendor_FreeBSD   = Resource { name = "vendor-freebsd.png"      type = File  file { filePath = "vendor-freebsd.png" } }
    Vendor_Linux     = Resource { name = "vendor-linux.png"        type = File  file { filePath = "vendor-linux.png" } }
    Vendor_Windows   = Resource { name = "vendor-windows.png"      type = File  file { filePath = "vendor-windows.png" } }
    Vendor_Raspberry = Resource { name = "vendor-raspberry_pi.png" type = File  file { filePath = "vendor-raspberry_pi.png" } }
    Vendor_OpenGL    = Resource { name = "vendor-opengl.png"       type = File  file { filePath = "vendor-opengl.png" } }
    Vendor_Vulkan    = Resource { name = "vendor-vulkan.png"       type = File  file { filePath = "vendor-vulkan.png" } }
    Vendor_DirectX   = Resource { name = "vendor-directx.png"      type = File  file { filePath = "vendor-directx.png" } }
    Vendor_Alsa      = Resource { name = "vendor-alsa.png"         type = File  file { filePath = "vendor-alsa.png" } }
    Vendor_XLib      = Resource { name = "vendor-xlib.png"         type = File  file { filePath = "vendor-xlib.png" } }

    # Demo screenshots
    Demo_ImGUI           = Resource { name = "demo_imgui.png"     type = File  file { filePath = "demo_imgui.png" } }
    Demo_FFMPEG          = Resource { name = "demo_ffmpeg.png"    type = File  file { filePath = "demo_ffmpeg.png" } }
    Demo_NBodySimulation = Resource { name = "demo_nbodysim.png"  type = File  file { filePath = "demo_nbodysim.png" } }
    Demo_Audio           = Resource { name = "demo_audio.png"     type = File  file { filePath = "demo_audio.png" } }
    Demo_Input           = Resource { name = "demo_input.png"     type = File  file { filePath = "demo_input.png" } }
    Demo_Crackout        = Resource { name = "demo_crackout.png"  type = File  file { filePath = "demo_crackout.png" } }
    Demo_OpenGL          = Resource { name = "demo_opengl.png"    type = File  file { filePath = "demo_opengl.png" } }
    Demo_Emulator        = Resource { name = "demo_emulator.png" type = File  file { filePath = "demo_emulator.png" } }

    # How-it-works icons
    Feature_SingleHeaderFile  = Resource { name = "singleheaderfile.png"  type = File  file { filePath = "singleheaderfile.png" } }
    Feature_RuntimeLinking    = Resource { name = "runtimelinking.png"    type = File  file { filePath = "runtimelinking.png" } }
    Feature_PreProcessor      = Resource { name = "preprocessor.png"      type = File  file { filePath = "preprocessor.png" } }
    Feature_NoCodeDuplication = Resource { name = "nocodeduplication.png" type = File  file { filePath = "nocodeduplication.png" } }
}

# -----------------------------------------------------------------------------
# Constants (font sizes, colors, layout offsets)
# -----------------------------------------------------------------------------
Const {
    CodeFontSize     = 24.0
    FeaturesFontSize = 32.0
    HeaderFontSize   = 24.0
    TitleFontSize    = 64.0
    NormalFontSize   = 42.0
    ConsoleFontSize  = 36.0
    DefaultLineScale = 1.15

    White      = V4f(1, 1, 1, 1)
    Black      = V4f(0, 0, 0, 1)
    WhiteHalf  = V4f(1, 1, 1, 0.5)
    WhiteSoft  = V4f(1, 1, 1, 0.85)
    WhiteFaint = V4f(1, 1, 1, 0.65)
    WhiteGhost = V4f(1, 1, 1, 0.05)
    LinkGreen  = V4f(0.0, 0.8, 0.2, 1.0)

    TextShadowOffset = V2f(2, 1)
}

# -----------------------------------------------------------------------------
# Backgrounds (HalfGradientHorizontal: primary -> secondary)
# RGBA24(0xRRGGBB, 0xAA), RGBA32(0xRRGGBBAA), and RGBA(0xRR,0xGG,0xBB,0xAA) return linear-space Vec4f.
# -----------------------------------------------------------------------------
Backgrounds {
    FixedBackground = BackgroundStyle { kind = HalfGradientHorizontal  primaryColor = RGBA24(0x000000, 255)  secondaryColor = RGBA24(0x0483AF, 100) }
    DarkBlueBack    = BackgroundStyle { kind = HalfGradientHorizontal  primaryColor = RGBA24(0x000000, 255)  secondaryColor = RGBA(15, 13, 80, 255) }

    # DarkBlue -> LightBlue
    Background1  = BackgroundStyle { kind = HalfGradientHorizontal  primaryColor = RGBA24(0x000000, 255)  secondaryColor = RGBA24(0x333789, 100) }
    Background2  = BackgroundStyle { kind = HalfGradientHorizontal  primaryColor = RGBA24(0x000000, 255)  secondaryColor = RGBA24(0x1E5AA3, 100) }
    Background3  = BackgroundStyle { kind = HalfGradientHorizontal  primaryColor = RGBA24(0x000000, 255)  secondaryColor = RGBA24(0x0483AF, 100) }

    # Green -> Yellow
    Background4  = BackgroundStyle { kind = HalfGradientHorizontal  primaryColor = RGBA24(0x000000, 255)  secondaryColor = RGBA24(0x057F47, 100) }
    Background5  = BackgroundStyle { kind = HalfGradientHorizontal  primaryColor = RGBA24(0x000000, 255)  secondaryColor = RGBA24(0x7AB30B, 100) }
    Background6  = BackgroundStyle { kind = HalfGradientHorizontal  primaryColor = RGBA24(0x000000, 255)  secondaryColor = RGBA24(0xF2E500, 100) }

    # LightOrange -> DarkOrange
    Background7  = BackgroundStyle { kind = HalfGradientHorizontal  primaryColor = RGBA24(0x000000, 255)  secondaryColor = RGBA24(0xFDBD00, 100) }
    Background8  = BackgroundStyle { kind = HalfGradientHorizontal  primaryColor = RGBA24(0x000000, 255)  secondaryColor = RGBA24(0xEE7B00, 100) }
    Background9  = BackgroundStyle { kind = HalfGradientHorizontal  primaryColor = RGBA24(0x000000, 255)  secondaryColor = RGBA24(0xE54B0A, 100) }
    Background10 = BackgroundStyle { kind = HalfGradientHorizontal  primaryColor = RGBA24(0x000000, 255)  secondaryColor = RGBA24(0xE54B0A, 200) }

    # Red -> Purple
    Background11 = BackgroundStyle { kind = HalfGradientHorizontal  primaryColor = RGBA24(0x000000, 255)  secondaryColor = RGBA24(0xDC0012, 100) }
    Background12 = BackgroundStyle { kind = HalfGradientHorizontal  primaryColor = RGBA24(0x000000, 255)  secondaryColor = RGBA24(0xB7006A, 100) }
    Background13 = BackgroundStyle { kind = HalfGradientHorizontal  primaryColor = RGBA24(0x000000, 255)  secondaryColor = RGBA24(0x59227A, 100) }

    # Purple -> Brown
    Background14 = BackgroundStyle { kind = HalfGradientHorizontal  primaryColor = RGBA24(0x000000, 255)  secondaryColor = RGBA24(0x237b75, 100) }
    Background15 = BackgroundStyle { kind = HalfGradientHorizontal  primaryColor = RGBA24(0x000000, 255)  secondaryColor = RGBA24(0x6d7b23, 100) }
    Background16 = BackgroundStyle { kind = HalfGradientHorizontal  primaryColor = RGBA24(0x000000, 255)  secondaryColor = RGBA24(0x7b5223, 100) }
}

# -----------------------------------------------------------------------------
# Text styles
# -----------------------------------------------------------------------------
TextStyles {
    Basic = TextStyle {
        foregroundColor = Const.White
        shadowColor     = Const.Black
        shadowOffset    = Const.TextShadowOffset
        drawShadow      = true
    }

    Header = TextStyle {
        foregroundColor = Const.White
        shadowColor     = Const.Black
        shadowOffset    = V2f(1, 1)
        drawShadow      = true
    }
}

# -----------------------------------------------------------------------------
# Slides
# -----------------------------------------------------------------------------

SlideDefinition Intro {
    name    = "Introduction"
    duration = 18.5
    rotation = QuatFromAngleAxis(0.0, V3f(1, 1, 1))
    background = Backgrounds.FixedBackground

    talk = "Hi! I am Torsten"
           "Today, i would like to introduce you to a project of mine that i have been working on for several years"
           "It is called 'Final Platform Layer' or short FPL and is a platform abstraction library for C and C++"

    blocks = [
        {
            type = Text
            pos  = V2f(0.0, 0.0)
            size = V2f(1.0, 1.0)
            contentAlignment = { h = Center, v = Middle }
            text {
                text      = "Introducing Final-Platform-Layer (FPL)\n"
                            "A lightweight platform abstraction library written in C99\n"
                textAlign = Center
            }
        }
    ]

    sounds = [
        { name = Sounds.Intro1.name, startTime = 1.0  }
        { name = Sounds.Intro2.name, startTime = 10.0 }
    ]
}

SlideDefinition WhoAmI {
    name    = "Who am I"
    duration = 20.5
    rotation = QuatFromAngleAxis(15.0, V3f(1, 1, 1))
    background = Backgrounds.FixedBackground

    talk = "I am Torsten Spaete"
           "A professional software engineer with more than 25 years of programming experience"
           "My main focus is data-visualization, software-architecture, multimedia and game development"

    blocks = [
        {
            type = Image
            pos  = V2f(0.0, 0.0)
            size = V2f(0.45, 0.45)
            contentAlignment = { h = Left, v = Top }
            image {
                imageResource = Images.DataVisualization
                size       = V2f(1.0, 1.0)
                keepAspect = true
                tintColor  = Const.WhiteHalf
            }
        }
        {
            type = Image
            pos  = V2f(0.55, 0.0)
            size = V2f(0.45, 0.45)
            contentAlignment = { h = Right, v = Top }
            image {
                imageResource = Images.MultimediaDev
                size       = V2f(1.0, 1.0)
                keepAspect = true
                tintColor  = Const.WhiteHalf
            }
        }
        {
            type = Image
            pos  = V2f(0.0, 0.50)
            size = V2f(0.45, 0.45)
            contentAlignment = { h = Left, v = Bottom }
            image {
                imageResource = Images.FluidSandbox
                size       = V2f(1.0, 1.0)
                keepAspect = true
                tintColor  = Const.WhiteHalf
            }
        }
        {
            type = Image
            pos  = V2f(0.55, 0.50)
            size = V2f(0.45, 0.45)
            contentAlignment = { h = Right, v = Bottom }
            image {
                imageResource = Images.GameDev
                size       = V2f(1.0, 1.0)
                keepAspect = true
                tintColor  = Const.WhiteHalf
            }
        }
        {
            type = Text
            pos  = V2f(0.0, 0.0)
            size = V2f(1.0, 1.0)
            contentAlignment = { h = Center, v = Middle }
            text {
                text      = "I am Torsten Spaete\n"
                            "A professional software engineer\n"
                            "25+ years of programming experience\n"
                textAlign = Center
            }
        }
    ]

    sounds = [
        { name = Sounds.WhoAmi1.name, startTime = 2.0 }
    ]
}

SlideDefinition WhatIsFPL {
    name    = "What is FPL"
    duration = 33.0
    rotation = QuatFromAngleAxis(-45.0, V3f(0, 1, 1))
    background = Backgrounds.FixedBackground

    talk = "Final-Platform-Layer (or short 'FPL') is a lightweight platform-abstraction library written in C99,"
           "that gives you access to low-level systems, hardware devices and operating system functions,"
           "in a platform independent and easy-to-use API."
           ""
           "For example you can:"
           "- Play audio samples on any audio device"
           "- Create and manage windows, including the initialization of a video graphics api, such as OpenGL, Vulkan"
           "- Query keyboard, mouse and gamepad input"
           "- Execute code in parallel, using several multithreading techniques"
           "- Allocate and free memory directly on the platform, without the use of malloc or free"
           "- Modify and query files & directories"
           "- Query several platform and hardware informations"
           "- and much more"
           ""
           "Its main usage is multimedia and game development, but it can be used to write any kind of software."
           "'FPL' is designed to be fast in compile and run time and can be integrated however you like."

    blocks = [
        {
            type = Image
            pos  = V2f(0.0, -0.1)
            size = V2f(1.0, 1.0)
            contentAlignment = { h = Center, v = Middle }
            image {
                imageResource = Images.Code
                size       = V2f(1.0, 1.2)
                keepAspect = false
                tintColor  = Const.WhiteGhost
            }
        }
        {
            type = Text
            pos  = V2f(0.0, 0.0)
            size = V2f(1.0, 1.0)
            contentAlignment = { h = Center, v = Middle }
            text {
                text      = "Final-Platform-Layer (or short 'FPL')\n"
                            "is a lightweight library written in C99 with support for C++.\n"
                            "\n"
                            "It provides a powerful and easy to use API,\n"
                            "that gives you access to low-level systems, hardware devices,\n"
                            "operating system functions and many more."
                textAlign = Left
            }
        }
    ]

    sounds = [
        { name = Sounds.What1.name, startTime = 1.0  }
        { name = Sounds.What2.name, startTime = 17.0 }
    ]
}

SlideDefinition Motivation {
    name    = "Motivation"
    duration = 31.0
    rotation = QuatFromAngleAxis(70.0, V3f(1.0, 0.1, 0.0))
    background = Backgrounds.FixedBackground

    talk = "C/C++ has very limited access to the underlying platform."
           "Even in modern C++, you still don't have direct access to a lot of systems."
           "To access low-level systems, such as audio or video or windowing systems, you either need to use third-party libraries"
           "or write platform-specific code directly for every platform you want to support."

    blocks = [
        {
            type = Text
            pos  = V2f(0.0, 0.0)
            size = V2f(1.0, 1.0)
            contentAlignment = { h = Center, v = Middle }
            text {
                text      = "C/C++ has very limited access to the underlying platform,\n"
                            "so you either have to use third-party libraries or\n"
                            "write platform specific code directly.\n"
                textAlign = Left
            }
        }
    ]

    sounds = [
        { name = Sounds.Motivation.name, startTime = 2.0 }
    ]
}

SlideDefinition Features {
    name    = "Features"
    duration = 0.0
    rotation = QuatFromAngleAxis(30.0, V3f(0.0, 1.0, 0.1))
    background = Backgrounds.FixedBackground

    talk = "FPL was designed to make the creation of multimedia applications or games very easy."
           ""
           "- It can create and manage a window for you, including the handling of events"
           "- It can handle keyboard & mouse devices"
           "- It can handle gamepads as well"
           "- It can initialize a graphics backend for you, such as OpenGL, Vulkan or allows you to put pixels directly on the screen"
           "- It can play back sound samples asynchrously"
           "- It is written in C99 for simplicity and best portability, but is 100% c++ compatible"
           "- It is designed to be fast in compile and runtime"
           "- It does not require any build-systems or thirdparty libraries"
           "- It gives you control of memory allocations and handles memory very gracefully"
           "- It supports the major architectures: X86, X64 and ARM"
           "- It supports many compilers and platforms and provides useful utilities fo work with them"
           "- It is highly configurable and many features can be compiled out, if needed"
           "- It provides useful primitives to create code that runs on different threads"
           "- In addition it contains a ton of useful functions and macros"

    blocks = [
        # Row 1 - cards
        { type = Image  pos = V2f(0.0, 0.1)  size = V2f(0.2, 0.2)  contentAlignment = { h = Center, v = Top }  image { imageResource = Images.Card_WindowManagement  size = V2f(1, 1)  keepAspect = true  tintColor = Const.White } }
        { type = Image  pos = V2f(0.2, 0.1)  size = V2f(0.2, 0.2)  contentAlignment = { h = Center, v = Top }  image { imageResource = Images.Card_KeyboardMouse     size = V2f(1, 1)  keepAspect = true  tintColor = Const.White } }
        { type = Image  pos = V2f(0.4, 0.1)  size = V2f(0.2, 0.2)  contentAlignment = { h = Center, v = Top }  image { imageResource = Images.Card_Gamepad           size = V2f(1, 1)  keepAspect = true  tintColor = Const.White } }
        { type = Image  pos = V2f(0.6, 0.1)  size = V2f(0.2, 0.2)  contentAlignment = { h = Center, v = Top }  image { imageResource = Images.Card_Video             size = V2f(1, 1)  keepAspect = true  tintColor = Const.White } }
        { type = Image  pos = V2f(0.8, 0.1)  size = V2f(0.2, 0.2)  contentAlignment = { h = Center, v = Top }  image { imageResource = Images.Card_Audio             size = V2f(1, 1)  keepAspect = true  tintColor = Const.White } }

        # Row 1 - labels
        { type = Text  pos = V2f(0.0, 0.3)  size = V2f(0.2, 0.1)  contentAlignment = { h = Center, v = Top }  text { text = "Window Management"    textAlign = Left  fontSize = 20.0 } }
        { type = Text  pos = V2f(0.2, 0.3)  size = V2f(0.2, 0.1)  contentAlignment = { h = Center, v = Top }  text { text = "Input Handling"       textAlign = Left  fontSize = 20.0 } }
        { type = Text  pos = V2f(0.4, 0.3)  size = V2f(0.2, 0.1)  contentAlignment = { h = Center, v = Top }  text { text = "Gamepad Support"      textAlign = Left  fontSize = 20.0 } }
        { type = Text  pos = V2f(0.6, 0.3)  size = V2f(0.2, 0.1)  contentAlignment = { h = Center, v = Top }  text { text = "Video Initialization" textAlign = Left  fontSize = 20.0 } }
        { type = Text  pos = V2f(0.8, 0.3)  size = V2f(0.2, 0.1)  contentAlignment = { h = Center, v = Top }  text { text = "Audio Playback"       textAlign = Left  fontSize = 20.0 } }

        # Row 2 - cards
        { type = Image  pos = V2f(0.0, 0.55)  size = V2f(0.2, 0.2)  contentAlignment = { h = Center, v = Top }  image { imageResource = Images.Card_C_Language      size = V2f(1, 1)  keepAspect = true  tintColor = Const.White } }
        { type = Image  pos = V2f(0.2, 0.55)  size = V2f(0.2, 0.2)  contentAlignment = { h = Center, v = Top }  image { imageResource = Images.Card_Performance     size = V2f(1, 1)  keepAspect = true  tintColor = Const.White } }
        { type = Image  pos = V2f(0.4, 0.55)  size = V2f(0.2, 0.2)  contentAlignment = { h = Center, v = Top }  image { imageResource = Images.Card_NoDependencies  size = V2f(1, 1)  keepAspect = true  tintColor = Const.White } }
        { type = Image  pos = V2f(0.6, 0.55)  size = V2f(0.2, 0.2)  contentAlignment = { h = Center, v = Top }  image { imageResource = Images.Card_Memory          size = V2f(1, 1)  keepAspect = true  tintColor = Const.White } }
        { type = Image  pos = V2f(0.8, 0.55)  size = V2f(0.2, 0.2)  contentAlignment = { h = Center, v = Top }  image { imageResource = Images.Card_CPU             size = V2f(1, 1)  keepAspect = true  tintColor = Const.White } }

        # Row 2 - labels
        { type = Text  pos = V2f(0.0, 0.75)  size = V2f(0.2, 0.1)  contentAlignment = { h = Center, v = Top }  text { text = "Written in C99"         textAlign = Left  fontSize = 20.0 } }
        { type = Text  pos = V2f(0.2, 0.75)  size = V2f(0.2, 0.1)  contentAlignment = { h = Center, v = Top }  text { text = "High Performance"       textAlign = Left  fontSize = 20.0 } }
        { type = Text  pos = V2f(0.4, 0.75)  size = V2f(0.2, 0.1)  contentAlignment = { h = Center, v = Top }  text { text = "No Dependencies"        textAlign = Left  fontSize = 20.0 } }
        { type = Text  pos = V2f(0.6, 0.75)  size = V2f(0.2, 0.1)  contentAlignment = { h = Center, v = Top }  text { text = "Small Memory Footprint" textAlign = Left  fontSize = 20.0 } }
        { type = Text  pos = V2f(0.8, 0.75)  size = V2f(0.2, 0.1)  contentAlignment = { h = Center, v = Top }  text { text = "Architecture Support"   textAlign = Left  fontSize = 20.0 } }
    ]
}

SlideDefinition Platforms {
    name    = "Supported Platforms"
    duration = 0.0
    rotation = QuatFromAngleAxis(75.0, V3f(-0.5, 0.65, 0.5))
    background = Backgrounds.FixedBackground

    talk = "FPL supports the major operating systems, such as Windows, Linux, Raspberry Pi and Unix or BSD"

    blocks = [
        { type = Image  pos = V2f(0.0, 0.2)  size = V2f(0.2, 0.2)  contentAlignment = { h = Center, v = Bottom }  image { imageResource = Images.Vendor_Windows    size = V2f(1, 1)  keepAspect = true  tintColor = Const.White } }
        { type = Image  pos = V2f(0.1, 0.2)  size = V2f(0.2, 0.2)  contentAlignment = { h = Center, v = Bottom }  image { imageResource = Images.Vendor_Linux      size = V2f(1, 1)  keepAspect = true  tintColor = Const.White } }
        { type = Image  pos = V2f(0.2, 0.2)  size = V2f(0.2, 0.2)  contentAlignment = { h = Center, v = Bottom }  image { imageResource = Images.Vendor_Raspberry  size = V2f(1, 1)  keepAspect = true  tintColor = Const.White } }
        { type = Image  pos = V2f(0.3, 0.2)  size = V2f(0.2, 0.2)  contentAlignment = { h = Center, v = Bottom }  image { imageResource = Images.Vendor_FreeBSD    size = V2f(1, 1)  keepAspect = true  tintColor = Const.White } }
        { type = Image  pos = V2f(0.4, 0.6)  size = V2f(0.2, 0.2)  contentAlignment = { h = Center, v = Bottom }  image { imageResource = Images.Vendor_OpenGL     size = V2f(1, 1)  keepAspect = true  tintColor = Const.White } }
        { type = Image  pos = V2f(0.5, 0.6)  size = V2f(0.2, 0.2)  contentAlignment = { h = Center, v = Bottom }  image { imageResource = Images.Vendor_Vulkan     size = V2f(1, 1)  keepAspect = true  tintColor = Const.White } }
        { type = Image  pos = V2f(0.6, 0.6)  size = V2f(0.2, 0.2)  contentAlignment = { h = Center, v = Bottom }  image { imageResource = Images.Vendor_DirectX    size = V2f(1, 1)  keepAspect = true  tintColor = Const.White } }
