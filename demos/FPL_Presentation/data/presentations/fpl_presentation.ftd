}

Slide HowItWorks {
    title    = "How it actually works"
    duration = 0.0
    rotation = { angleDegrees = 45.0, axis = V3f(0.5, 0.5, 0.5) }
    background = FixedBackground

    talk = "Of course, there is no magic involved - it uses just a few tricks."
           ""
           "FPL is a 'single-header-file-library', so it contains the full header or API and implementation for every platform in a single C file"
           "It makes heavy use of the pre-processor to detect compiler/platform/hardware/driver setups"
           "It prevents code duplication by using sub platforms"
           "It uses runtime linking by default, so everything is automatically loaded on demand"

    blocks = [
        { type = Image  pos = V2f(0.05, 0.125)  size = V2f(0.15, 0.65)  contentAlignment = { h = Left, v = Middle }  image { imageResource = Feature_SingleHeaderFile   size = V2f(1, 1)  keepAspect = false  tintColor = White } }
        { type = Image  pos = V2f(0.30, 0.125)  size = V2f(0.15, 0.65)  contentAlignment = { h = Left, v = Middle }  image { imageResource = Feature_PreProcessor       size = V2f(1, 1)  keepAspect = false  tintColor = White } }
        { type = Image  pos = V2f(0.55, 0.125)  size = V2f(0.15, 0.65)  contentAlignment = { h = Left, v = Middle }  image { imageResource = Feature_NoCodeDuplication  size = V2f(1, 1)  keepAspect = false  tintColor = White } }
        { type = Image  pos = V2f(0.80, 0.125)  size = V2f(0.15, 0.65)  contentAlignment = { h = Left, v = Middle }  image { imageResource = Feature_RuntimeLinking     size = V2f(1, 1)  keepAspect = false  tintColor = White } }
    ]
}

Slide Constraints {
    title    = "Constraints"
    duration = 0.0
    rotation = { angleDegrees = 65.0, axis = V3f(0.0, 0.5, 1.0) }
    background = FixedBackground

    talk = "FPL is lightweight, so the feature set is limited. As a result, you'll need to provide some functionality."
           ""
           "Video rendering is intentionally excluded, giving users the flexibility to integrate their own solutions"
           ""
           "Audio sample conversion is intentionally excluded, giving users the flexibility to integrate their own solutions"
           ""
           "Platform support are limited to X86 or ARM, both with support for 32-bit or 64-bit"
           "More platforms may be added in the future, such as MacOS, Android or server-based platforms."

    blocks = [
        {
            type = Text
            pos  = V2f(0.0, 0.0)
            size = V2f(1.0, 1.0)
            contentAlignment = { h = Center, v = Middle }
            text {
                text      = "- Video rendering must be provided yourself\n"
                            "\n"
                            "- Audio sample conversion must be provided yourself\n"
                            "\n"
                            "Platform support are constrained to:\n"
                            "- X86/X64/ARM32/ARM64\n"
                            "- Windows/Linux/Unix\n"
                textAlign = Left
                fontSize  = 40.0
            }
        }
    ]
}

Slide HowToUse {
    title    = "How to use"
    duration = 0.0
    rotation = { angleDegrees = 75.0, axis = V3f(0.0, 1.0, 0.0) }
    background = FixedBackground

    talk = ""

    blocks = [
        {
            type = Image
            pos  = V2f(0.075, 0.0)
            size = V2f(0.85, 1.0)
            contentAlignment = { h = Center, v = Middle }
            image {
                imageResource = MinimumSource
                size       = V2f(1.0, 1.0)
                keepAspect = false
                tintColor  = WhiteSoft
            }
        }
    ]
}

Slide Demos {
    title    = "Demos!"
    duration = 0.0
    rotation = { angleDegrees = -45.0, axis = V3f(1.0, 0.5, 0.25) }
    background = FixedBackground

    talk = "FPL comes with a lot of fully working demos, so you can learn how it works."

    blocks = [
        { type = Image  pos = V2f(0.00, 0.0)  size = V2f(0.25, 0.25)  contentAlignment = { h = Center, v = Middle }  image { imageResource = Demo_ImGUI            size = V2f(1, 1)  keepAspect = true  tintColor = WhiteFaint } }
        { type = Image  pos = V2f(0.25, 0.0)  size = V2f(0.25, 0.25)  contentAlignment = { h = Center, v = Middle }  image { imageResource = Demo_FFMPEG           size = V2f(1, 1)  keepAspect = true  tintColor = WhiteFaint } }
        { type = Image  pos = V2f(0.50, 0.0)  size = V2f(0.25, 0.25)  contentAlignment = { h = Center, v = Middle }  image { imageResource = Demo_Audio            size = V2f(1, 1)  keepAspect = true  tintColor = WhiteFaint } }
        { type = Image  pos = V2f(0.75, 0.0)  size = V2f(0.25, 0.25)  contentAlignment = { h = Center, v = Middle }  image { imageResource = Demo_Input            size = V2f(1, 1)  keepAspect = true  tintColor = WhiteFaint } }
        { type = Image  pos = V2f(0.00, 0.6)  size = V2f(0.25, 0.25)  contentAlignment = { h = Center, v = Middle }  image { imageResource = Demo_OpenGL           size = V2f(1, 1)  keepAspect = true  tintColor = WhiteFaint } }
        { type = Image  pos = V2f(0.25, 0.6)  size = V2f(0.25, 0.25)  contentAlignment = { h = Center, v = Middle }  image { imageResource = Demo_Crackout         size = V2f(1, 1)  keepAspect = true  tintColor = WhiteFaint } }
        { type = Image  pos = V2f(0.50, 0.6)  size = V2f(0.25, 0.25)  contentAlignment = { h = Center, v = Middle }  image { imageResource = Demo_Raytracer        size = V2f(1, 1)  keepAspect = true  tintColor = WhiteFaint } }
        { type = Image  pos = V2f(0.75, 0.6)  size = V2f(0.25, 0.25)  contentAlignment = { h = Center, v = Middle }  image { imageResource = Demo_NBodySimulation  size = V2f(1, 1)  keepAspect = true  tintColor = WhiteFaint } }

        {
            type = Text
            pos  = V2f(0.0, 0.3)
            size = V2f(1.0, 0.1)
            contentAlignment = { h = Center, v = Middle }
            text {
                text      = "FPL comes with a variety of demos:"
                textAlign = Center
                fontSize  = FeaturesFontSize
            }
        }
        {
            type = Text
            pos  = V2f(0.0, 0.4)
            size = V2f(1.0, 0.1)
            contentAlignment = { h = Center, v = Middle }
            text {
                text      = "https://github.com/f1nalspace/final_game_tech/tree/master/demos"
                textAlign = Center
                fontSize  = FeaturesFontSize
                color     = LinkGreen
            }
        }
    ]
}

Slide Links {
    title    = "Links"
    duration = 0.0
    rotation = { angleDegrees = 65.0, axis = V3f(1, 0, 0) }
    background = FixedBackground

    talk = "If you are interested about learning more about FPL, you can visit the official website: libfpl.org"
           ""
           "Or go to the github repository directly"
           ""
           "If you are watching this presentation over a streaming platform, you can also find all the links in the description below."

    blocks = [
        {
            type = Text
            pos  = V2f(0.25, 0.0)  size = V2f(0.5, 0.1)
            contentAlignment = { h = Left, v = Middle }
            text { text = "Official website (details, releases, documentation):"  textAlign = Left  fontSize = FeaturesFontSize }
        }
        {
            type = Text
            pos  = V2f(0.25, 0.1)  size = V2f(0.5, 0.1)
            contentAlignment = { h = Left, v = Middle }
            text { text = "https://libfpl.org"  textAlign = Left  fontSize = FeaturesFontSize  color = LinkGreen }
        }
        {
            type = Text
            pos  = V2f(0.25, 0.3)  size = V2f(0.5, 0.1)
            contentAlignment = { h = Left, v = Middle }
            text { text = "Github (sources, issue-tracker, project management):"  textAlign = Left  fontSize = FeaturesFontSize }
        }
        {
            type = Text
            pos  = V2f(0.25, 0.4)  size = V2f(0.5, 0.1)
            contentAlignment = { h = Left, v = Middle }
            text { text = "https://github.com/f1nalspace/final_game_tech"  textAlign = Left  fontSize = FeaturesFontSize  color = LinkGreen }
        }
        {
            type = Text
            pos  = V2f(0.25, 0.6)  size = V2f(0.5, 0.1)
            contentAlignment = { h = Left, v = Middle }
            text { text = "Handmade-Network (community):"  textAlign = Left  fontSize = FeaturesFontSize }
        }
        {
            type = Text
            pos  = V2f(0.25, 0.7)  size = V2f(0.5, 0.1)
            contentAlignment = { h = Left, v = Middle }
            text { text = "https://fpl.handmade.network"  textAlign = Left  fontSize = FeaturesFontSize  color = LinkGreen }
        }
    ]
}

Slide Thanks {
    title    = "Thanks!"
    duration = 0.0
    rotation = { angleDegrees = 0.0, axis = V3f(1, 1, 1) }   # 0 deg => identity quaternion
    background = FixedBackground

    talk = "Thank you for watching this presentation and i hope you will give FPL a try."
           ""
           "Feel free to post any questions or feedback on github or if possible, as a comment to this video."
           ""
           "As always, keep coding!"

    blocks = [
        {
            type = Image
            pos  = V2f(0.4, 0.4)  size = V2f(0.6, 0.6)
            contentAlignment = { h = Right, v = Bottom }
            image {
                imageResource = Arigatou
                size       = V2f(1.0, 1.0)
                keepAspect = true
                tintColor  = WhiteFaint
            }
        }
        {
            type = Text
            pos  = V2f(0, 0)  size = V2f(1, 1)
            contentAlignment = { h = Center, v = Middle }
            text {
                text      = "Thank you for your attention!"
                textAlign = Center
            }
        }
    ]
}

# -----------------------------------------------------------------------------
# Header / Footer
# -----------------------------------------------------------------------------
HeaderDefinition Header {
    font {
        name      = Arimo              # host-registered FontResource (via alias)
        size      = HeaderFontSize
        lineScale = DefaultLineScale
        style     = HeaderStyle
    }
    height     = 32.0
    leftText   = "Final-Platform-Layer"
    centerText = ""
    rightText  = ""
    padding    = V2f(2, 2)
}

FooterDefinition Footer {
    font {
        name      = Arimo
        size      = HeaderFontSize
        lineScale = DefaultLineScale
        style     = HeaderStyle
    }
    height     = 32.0
    leftText   = "%SLIDE_NAME%"
    centerText = "Copyright (C) 2017-2025 Torsten Spaete"
    rightText  = "Page %SLIDE_NUM% of %SLIDE_COUNT%"
    padding    = V2f(2, 3)
}

# -----------------------------------------------------------------------------
# Presentation root - the entry point a loader should resolve
# -----------------------------------------------------------------------------
Presentation FPLPresentation {
    slideSize = V2f(1280.0, 720.0)
    padding   = 20.0

    slides = [
        Intro
        WhoAmI
        WhatIsFPL
        Motivation
        Features
        Platforms
        Magic
        HowItWorks
        Constraints
        HowToUse
        Demos
        Links
        Thanks
    ]

    header = Header
    footer = Footer

    titleFont   { name = Arimo              size = TitleFontSize    lineScale = DefaultLineScale  style = BasicStyle }
    normalFont  { name = Arimo              size = NormalFontSize   lineScale = DefaultLineScale  style = BasicStyle }
    consoleFont { name = BitStreamVerySans  size = ConsoleFontSize  lineScale = DefaultLineScale  style = BasicStyle }
}
