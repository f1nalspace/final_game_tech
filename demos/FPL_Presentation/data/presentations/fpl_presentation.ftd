SlideDefinition Magic {
    name    = "How it works"
    duration = 0.0
    rotation = QuatFromAngleAxis(-15.0, V3f(0.7, 0.6, 0.3))
    background = Backgrounds.FixedBackground

    talk = "It works with Magic!"

    blocks = [
        {
            type = Image
            pos  = V2f(-0.15, 0.0)
            size = V2f(1.0, 1.0)
            contentAlignment = { h = Center, v = Middle }
            image {
                imageResource = Images.MagicHat
                size       = V2f(0.75, 0.75)
                keepAspect = true
                tintColor  = Const.White
            }
        }
        {
            type = Text
            pos  = V2f(0.0, 0.0)
            size = V2f(1.0, 1.0)
            contentAlignment = { h = Center, v = Middle }
            text {
                text      = "Magic!"
                textAlign = Left
                fontSize  = 128.0
            }
        }
    ]
}

SlideDefinition HowItWorks {
    name    = "How it actually works"
    duration = 0.0
    rotation = QuatFromAngleAxis(45.0, V3f(0.5, 0.5, 0.5))
    background = Backgrounds.FixedBackground

    talk = "Of course, there is no magic involved - it uses just a few tricks."
           ""
           "FPL is a 'single-header-file-library', so it contains the full header or API and implementation for every platform in a single C file"
           "It makes heavy use of the pre-processor to detect compiler/platform/hardware/driver setups"
           "It prevents code duplication by using sub platforms"
           "It uses runtime linking by default, so everything is automatically loaded on demand"

    blocks = [
        { type = Image  pos = V2f(0.05, 0.125)  size = V2f(0.15, 0.65)  contentAlignment = { h = Left, v = Middle }  image { imageResource = Images.Feature_SingleHeaderFile   size = V2f(1, 1)  keepAspect = false  tintColor = Const.White } }
        { type = Image  pos = V2f(0.30, 0.125)  size = V2f(0.15, 0.65)  contentAlignment = { h = Left, v = Middle }  image { imageResource = Images.Feature_PreProcessor       size = V2f(1, 1)  keepAspect = false  tintColor = Const.White } }
        { type = Image  pos = V2f(0.55, 0.125)  size = V2f(0.15, 0.65)  contentAlignment = { h = Left, v = Middle }  image { imageResource = Images.Feature_NoCodeDuplication  size = V2f(1, 1)  keepAspect = false  tintColor = Const.White } }
        { type = Image  pos = V2f(0.80, 0.125)  size = V2f(0.15, 0.65)  contentAlignment = { h = Left, v = Middle }  image { imageResource = Images.Feature_RuntimeLinking     size = V2f(1, 1)  keepAspect = false  tintColor = Const.White } }
    ]
}

SlideDefinition Constraints {
    name    = "Constraints"
    duration = 0.0
    rotation = QuatFromAngleAxis(65.0, V3f(0.0, 0.5, 1.0))
    background = Backgrounds.FixedBackground

    talk = "FPL is lightweight, so the feature set is limited. As a result, you'll need to provide some functionality."
           ""
           "Video rendering is intentionally excluded, giving users the flexibility to integrate their own solutions"
           ""
           "Audio sample conversion is intentionally excluded, giving users the flexibility to integrate their own solutions"
           ""
           "Platform support are limited to X86 or ARM, both with support for 32-bit or 64-bit"
           "More platforms may be added in the future, such as MacOS, Android or server-based platforms."

    blocks = [
        {
            type = Text
            pos  = V2f(0.0, 0.0)
            size = V2f(1.0, 1.0)
            contentAlignment = { h = Center, v = Middle }
            text {
                text      = "- Video rendering must be provided yourself\n"
                            "\n"
                            "- Audio sample conversion must be provided yourself\n"
                            "\n"
                            "Platform support are constrained to:\n"
                            "- X86/X64/ARM32/ARM64\n"
                            "- Windows/Linux/Unix\n"
                textAlign = Left
                fontSize  = 40.0
            }
        }
    ]
}

