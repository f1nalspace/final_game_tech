# -----------------------------------------------------------------------------
# Header / Footer
# -----------------------------------------------------------------------------
HeaderDefinition Header {
    font {
        name      = Fonts.Arimo.name
        size      = Const.HeaderFontSize
        lineScale = Const.DefaultLineScale
        style     = TextStyles.Header
    }
    height     = 32.0
    leftText   = "Final-Platform-Layer"
    centerText = ""
    rightText  = ""
    padding    = V2f(2, 2)
}

FooterDefinition Footer {
    font {
        name      = Fonts.Arimo.name
        size      = Const.HeaderFontSize
        lineScale = Const.DefaultLineScale
        style     = TextStyles.Header
    }
    height     = 32.0
    leftText   = "%SLIDE_NAME%"
    centerText = "Copyright (C) 2017-2026 Torsten Spaete"
    rightText  = "Page %SLIDE_NUM% of %SLIDE_COUNT%"
    padding    = V2f(2, 3)
}

# -----------------------------------------------------------------------------
# Presentation definition - assembled into the PresentationFile root below
# -----------------------------------------------------------------------------
PresentationDefinition FPLPresentation {
    slideSize = V2f(1280.0, 720.0)
    padding   = 20.0

    slides = [
        Intro
        WhoAmI
        WhatIsFPL
        Motivation
        Features
        Platforms
        Magic
        HowItWorks
        Constraints
        HowToUse
        Demos
        Links
        Thanks
    ]

    header = Header
    footer = Footer

    titleFont   { name = Fonts.Arimo.name              size = Const.TitleFontSize    lineScale = Const.DefaultLineScale  style = TextStyles.Basic }
    normalFont  { name = Fonts.Arimo.name              size = Const.NormalFontSize   lineScale = Const.DefaultLineScale  style = TextStyles.Basic }
    consoleFont { name = Fonts.BitStreamVerySans.name  size = Const.ConsoleFontSize  lineScale = Const.DefaultLineScale  style = TextStyles.Basic }
}

# -----------------------------------------------------------------------------
# Presentation file root - bundles the presentation definition with the full
# list of resources it depends on. This is the entry point a loader should
# resolve when reading the .ftd file.
# -----------------------------------------------------------------------------
PresentationFile FPLPresentationFile {
    definition = FPLPresentation

    fonts = [
        Fonts.Debug
        Fonts.Arimo
        Fonts.SulphurPoint
        Fonts.BitStreamVerySans
    ]
    fontCount = 4

    sounds = [
        Sounds.Intro1
        Sounds.Intro2
        Sounds.WhoAmi1
        Sounds.What1
        Sounds.What2
        Sounds.Motivation
    ]
    soundCount = 6

    images = [
        Images.FPLLogo128x128
        Images.FPLLogo512x512

        Images.Card_CPU
        Images.Card_Memory
        Images.Card_C_Language
        Images.Card_Audio
        Images.Card_Video
        Images.Card_WindowManagement
        Images.Card_Performance
        Images.Card_NoDependencies
        Images.Card_KeyboardMouse
        Images.Card_Gamepad

        Images.MagicHat
        Images.Arigatou
        Images.MinimumSource

        Images.DataVisualization
        Images.GameDev
        Images.MultimediaDev
        Images.FluidSandbox
        Images.Code

        Images.Vendor_FreeBSD
        Images.Vendor_Linux
        Images.Vendor_Windows
        Images.Vendor_Raspberry
        Images.Vendor_OpenGL
        Images.Vendor_Vulkan
        Images.Vendor_DirectX
        Images.Vendor_Alsa
        Images.Vendor_XLib

        Images.Demo_ImGUI
        Images.Demo_FFMPEG
        Images.Demo_NBodySimulation
        Images.Demo_Audio
        Images.Demo_Input
        Images.Demo_Crackout
        Images.Demo_OpenGL
        Images.Demo_Emulator

        Images.Feature_SingleHeaderFile
        Images.Feature_RuntimeLinking
        Images.Feature_PreProcessor
        Images.Feature_NoCodeDuplication
    ]
    imageCount = 41
}
