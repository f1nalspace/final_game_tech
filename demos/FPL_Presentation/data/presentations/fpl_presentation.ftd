    talk = "FPL supports the major operating systems, such as Windows, Linux, Raspberry Pi and Unix or BSD"

    blocks = [
        { type = Image  pos = V2f(0.0, 0.2)  size = V2f(0.2, 0.2)  contentAlignment = { h = Center, v = Bottom }  image { imageResource = Vendor_Windows    size = V2f(1, 1)  keepAspect = true  tintColor = White } }
        { type = Image  pos = V2f(0.1, 0.2)  size = V2f(0.2, 0.2)  contentAlignment = { h = Center, v = Bottom }  image { imageResource = Vendor_Linux      size = V2f(1, 1)  keepAspect = true  tintColor = White } }
        { type = Image  pos = V2f(0.2, 0.2)  size = V2f(0.2, 0.2)  contentAlignment = { h = Center, v = Bottom }  image { imageResource = Vendor_Raspberry  size = V2f(1, 1)  keepAspect = true  tintColor = White } }
        { type = Image  pos = V2f(0.3, 0.2)  size = V2f(0.2, 0.2)  contentAlignment = { h = Center, v = Bottom }  image { imageResource = Vendor_FreeBSD    size = V2f(1, 1)  keepAspect = true  tintColor = White } }
        { type = Image  pos = V2f(0.4, 0.6)  size = V2f(0.2, 0.2)  contentAlignment = { h = Center, v = Bottom }  image { imageResource = Vendor_OpenGL     size = V2f(1, 1)  keepAspect = true  tintColor = White } }
        { type = Image  pos = V2f(0.5, 0.6)  size = V2f(0.2, 0.2)  contentAlignment = { h = Center, v = Bottom }  image { imageResource = Vendor_Vulkan     size = V2f(1, 1)  keepAspect = true  tintColor = White } }
        { type = Image  pos = V2f(0.6, 0.6)  size = V2f(0.2, 0.2)  contentAlignment = { h = Center, v = Bottom }  image { imageResource = Vendor_DirectX    size = V2f(1, 1)  keepAspect = true  tintColor = White } }
        { type = Image  pos = V2f(0.7, 0.6)  size = V2f(0.2, 0.2)  contentAlignment = { h = Center, v = Bottom }  image { imageResource = Vendor_Alsa       size = V2f(1, 1)  keepAspect = true  tintColor = White } }
        { type = Image  pos = V2f(0.8, 0.6)  size = V2f(0.2, 0.2)  contentAlignment = { h = Center, v = Bottom }  image { imageResource = Vendor_XLib       size = V2f(1, 1)  keepAspect = true  tintColor = White } }
    ]
}

