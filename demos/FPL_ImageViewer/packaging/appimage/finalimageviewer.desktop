[Desktop Entry]
Type=Application
Name=Final Image Viewer
GenericName=Image Viewer
Comment=Image viewer with exact scaling for JPEG, PNG, GIF, BMP, TGA, WebP, HEIC, AVIF, ICNS and PNM
Exec=finalimageviewer %f
Icon=finalimageviewer
Terminal=false
Categories=Graphics;Viewer;
MimeType=image/jpeg;image/png;image/gif;image/bmp;image/x-tga;image/webp;image/heif;image/heic;image/avif;image/x-icns;image/x-portable-anymap;image/x-portable-graymap;image/x-portable-pixmap;
StartupWMClass=finalimageviewer
