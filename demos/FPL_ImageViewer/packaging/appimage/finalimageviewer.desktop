[Desktop Entry]
Type=Application
Name=finalimageviewer
GenericName=Image Viewer
Comment=Image viewer with exact scaling for JPEG, PNG, BMP, TGA, WebP and PNM
Exec=finalimageviewer %f
Icon=finalimageviewer
Terminal=false
Categories=Graphics;Viewer;
MimeType=image/jpeg;image/png;image/bmp;image/x-tga;image/webp;image/x-portable-anymap;image/x-portable-graymap;image/x-portable-pixmap;
StartupWMClass=finalimageviewer
