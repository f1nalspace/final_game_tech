	@${MAKE} --no-print-directory -C OpenGLExtParser -f Makefile config=$(OpenGLExtParser_config)
endif

FontRendering:
ifneq (,$(FontRendering_config))
	@echo "==== Building FontRendering ($(FontRendering_config)) ===="
	@${MAKE} --no-print-directory -C FontRendering -f Makefile config=$(FontRendering_config)
endif

clean:
	@${MAKE} --no-print-directory -C mathtest -f Makefile clean
	@${MAKE} --no-print-directory -C gamepaddbgen -f Makefile clean
	@${MAKE} --no-print-directory -C staticdatamaker -f Makefile clean
	@${MAKE} --no-print-directory -C OpenGLExtParser -f Makefile clean
	@${MAKE} --no-print-directory -C FontRendering -f Makefile clean

